# Polymarket Trading Terminal Configuration
# Copy to .env and fill in your credentials

# ── Credentials ─────────────────────────────────────────────────
# Required for LIVE trading. Leave empty for read-only or paper mode.
POLY_PRIVATE_KEY=0x...

# Optional: Polygon chain ID (default: 137 for mainnet)
POLY_CHAIN_ID=137

# Optional: Signature type (0=EOA, 1=Magic/Email, 2=Proxy)
POLY_SIGNATURE_TYPE=0

# Optional: Funder address (required for proxy wallets)
POLY_FUNDER_ADDRESS=

# ── Paper Trading (Dry Run) ─────────────────────────────────────
# Set to true to enable paper trading mode.
# Uses live market data but simulates order execution locally.
# No private key needed. Great for testing strategies.
POLY_PAPER_TRADING=true
POLY_PAPER_BALANCE=10000

# ── Copy Trading ────────────────────────────────────────────────
# Set the wallet address of the trader you want to copy.
# The terminal polls their recent activity and mirrors trades.
POLY_COPY_TARGET=
POLY_COPY_ENABLED=false
POLY_COPY_MULTIPLIER=1.0
POLY_COPY_MAX_SIZE=500
POLY_COPY_AUTO_EXECUTE=false
POLY_COPY_POLL_INTERVAL=5
